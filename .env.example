# UniAPI 调试环境配置文件
# 复制本文件为 .env，然后根据实际情况修改配置

# ============= 服务器配置 =============
PORT=3000
LOG_LEVEL=debug
GIN_MODE=debug

# ============= 数据库配置 =============
# MySQL 数据库连接 (本地调试时使用)
DB_DSN=root:@tcp(127.0.0.1:3306)/uniapi?charset=utf8mb4&parseTime=True&loc=Local

# ============= Redis 配置 =============
# Redis 连接字符串
REDIS_URL=redis://127.0.0.1:6379/0

# ============= 日志配置 =============
LOG_DIR=./logs
LOG_FILENAME=uniapi.log
LOG_FORMAT=json

# ============= 前端配置 =============
FRONTEND_DIST_PATH=./web/build/modern

# ============= CORS 配置 =============
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# ============= 认证配置 =============
# JWT 密钥（调试时可以设置简单值）
JWT_SECRET=debug-secret-key-change-in-production

# ============= OpenTelemetry 配置（可选）=============
# OTEL_ENABLED=false
# OTEL_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============= 第三方 API 密钥示例（仅用于测试）=============
# OPENAI_API_KEY=your-api-key-here
# ANTHROPIC_API_KEY=your-api-key-here

# ============= 其他配置 =============
# 最大请求体大小 (字节)
MAX_REQUEST_BODY_SIZE=10485760

# 请求超时时间 (秒)
REQUEST_TIMEOUT=30
