# UniAPI 本地开发配置模板
# 复制本文件为 .env，然后根据实际情况修改配置。

# ============= 服务器配置 =============
PORT=3000
GIN_MODE=debug

# DEBUG=true 会开启更详细的结构化日志，可能包含更多请求上下文。
DEBUG=false

# ============= 会话与认证 =============
# 管理后台登录态依赖 SESSION_SECRET，生产环境必须替换为随机长字符串。
SESSION_SECRET=local-dev-session-secret-change-me

# ============= 数据库配置 =============
# 本地默认使用 SQLite，避免因为 MySQL 凭证未准备好导致无法启动。
SQLITE_PATH=./data/uniapi.db

# 如果你已经准备好了 MySQL，可改用下面这项并注释掉 SQLITE_PATH。
# SQL_DSN=root:your-password@tcp(127.0.0.1:3306)/uniapi?charset=utf8mb4&parseTime=True&loc=Local

# ============= Redis 配置 =============
# 单机本地开发可留空；需要验证限流、分布式缓存、sticky session 时再启用。
# REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# ============= 上游请求与用户内容抓取 =============
# 上游模型请求超时，建议显式设置，避免长请求无限等待。
RELAY_TIMEOUT=300

# 抓取外部图片、音频等用户内容的超时。
USER_CONTENT_REQUEST_TIMEOUT=30

# 流式连接空闲超时。
IDLE_TIMEOUT=30

# ============= OpenTelemetry（可选） =============
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_SERVICE_NAME=uniapi
# OTEL_ENVIRONMENT=local
