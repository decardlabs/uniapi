# File path: /etc/systemd/system/uniapi.service
# sudo systemctl daemon-reload
# sudo systemctl start uniapi
# sudo systemctl enable uniapi
# sudo systemctl status uniapi
[Unit]
Description=UniAPI Service
After=network.target

[Service]
User=uniapi
WorkingDirectory=/opt/uniapi
EnvironmentFile=/opt/uniapi/.env
ExecStart=/opt/uniapi/uniapi --port 10780 --log-dir /opt/uniapi/logs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
